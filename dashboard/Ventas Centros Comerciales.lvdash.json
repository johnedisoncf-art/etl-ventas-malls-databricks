{
  "datasets": [
    {
      "name": "f0588671",
      "displayName": "KPIs generales",
      "queryLines": [
        "SELECT\r\n",
        "  ROUND(SUM(total_ventas), 0)                       AS ventas_totales_soles,\r\n",
        "  SUM(num_tickets)                                  AS tickets,\r\n",
        "  ROUND(SUM(total_ventas) / SUM(num_tickets), 2)    AS ticket_promedio\r\n",
        "FROM catalog_prod.golden.ventas_mensuales_mall;"
      ]
    },
    {
      "name": "ce998108",
      "displayName": "Ventas mensuales por mall",
      "queryLines": [
        "SELECT make_date(anio, mes, 1) AS periodo, nombre_mall, operador,\r\n",
        "       total_ventas, num_tickets, ticket_promedio, crecimiento_vs_mes_anterior_pct\r\n",
        "FROM catalog_prod.golden.ventas_mensuales_mall\r\n",
        "ORDER BY periodo, nombre_mall;"
      ]
    },
    {
      "name": "abb2ec19",
      "displayName": "Top 5 tiendas por mall",
      "queryLines": [
        "SELECT nombre_mall, ranking_en_mall, nombre_tienda, rubro, total_ventas, participacion_mall_pct\r\n",
        "FROM catalog_prod.golden.ranking_tiendas\r\n",
        "WHERE ranking_en_mall <= 5\r\n",
        "ORDER BY nombre_mall, ranking_en_mall;"
      ]
    },
    {
      "name": "e4ed9a2d",
      "displayName": "Conversión visitantes",
      "queryLines": [
        "SELECT nombre_mall, es_fin_de_semana,\r\n",
        "       SUM(visitantes)                                        AS visitantes,\r\n",
        "       SUM(num_tickets)                                       AS tickets,\r\n",
        "       ROUND(SUM(num_tickets) / SUM(visitantes) * 100, 2)     AS tasa_conversion_pct,\r\n",
        "       ROUND(SUM(total_ventas) / SUM(visitantes), 2)          AS venta_por_visitante\r\n",
        "FROM catalog_prod.golden.conversion_diaria_mall\r\n",
        "GROUP BY nombre_mall, es_fin_de_semana;"
      ]
    },
    {
      "name": "ca37abdc",
      "displayName": "Medio de pago por rubro",
      "queryLines": [
        "SELECT rubro, medio_pago, monto\r\n",
        "FROM catalog_prod.golden.ventas_rubro_medio_pago\r\n",
        "UNPIVOT (monto FOR medio_pago IN (efectivo, plin, tarjeta_credito, tarjeta_debito, yape))\r\n",
        "ORDER BY rubro;"
      ]
    }
  ],
